<?xml version="1.0" encoding="utf-8"?>
<!-- Static preview shown in the Android 12+ widget picker.

     previewLayout is inflated without a RemoteViewsService, so the real
     appwidget.xml would render with an empty event list. This mirrors the
     same MD3 structure (rounded surface, month headline, filled FAB, chips)
     with representative sample rows.

     Keep this visually in sync with res/layout/appwidget.xml. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_container_bg"
    android:orientation="vertical"
    android:paddingStart="@dimen/widget_padding"
    android:paddingEnd="@dimen/widget_padding"
    android:paddingTop="@dimen/widget_padding"
    android:paddingBottom="4dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_preview_month"
                android:textColor="@color/widget_on_surface"
                android:textSize="@dimen/widget_title_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_preview_date"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="@dimen/widget_date_dow_text" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="@dimen/widget_fab_size"
            android:layout_height="@dimen/widget_fab_size"
            android:background="@drawable/widget_fab_bg">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_add_event"
                android:tint="@color/widget_fab_icon"
                android:contentDescription="@string/day_view_new_event_hint" />
        </FrameLayout>
    </LinearLayout>

    <!-- Sample event chips -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_chip_md3_filled"
        android:backgroundTint="@color/widget_preview_chip_1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/widget_preview_event_1"
        android:textColor="#FFFFFFFF"
        android:textSize="@dimen/widget_item_text" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/widget_row_spacing"
        android:background="@drawable/widget_chip_md3_filled"
        android:backgroundTint="@color/widget_preview_chip_2"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/widget_preview_event_2"
        android:textColor="#FFFFFFFF"
        android:textSize="@dimen/widget_item_text" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/widget_row_spacing"
        android:background="@drawable/widget_chip_md3_filled"
        android:backgroundTint="@color/widget_preview_chip_3"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/widget_preview_event_3"
        android:textColor="#FF1A1C1E"
        android:textSize="@dimen/widget_item_text" />
</LinearLayout>
