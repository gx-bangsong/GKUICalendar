<?xml version="1.0" encoding="utf-8"?>
<!--
  Switch widget for a Material 3 row. Same contract as androidx.preference
  preference_widget_switch_compat.xml: the id is @+id/switchWidget, and the switch is not
  focusable or clickable, so a tap on the row toggles the value once.
-->
<com.google.android.material.materialswitch.MaterialSwitch
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/switchWidget"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@null"
    android:focusable="false"
    android:clickable="false" />
