<!--
    One reminder row. The two dropdowns are stacked so the time field gets the
    full available width on narrow windows (it used to share the row with the
    method spinner, which truncated labels such as "1 小时"). The root stays a
    ConstraintLayout with the remove button as a direct child; EditEventView
    relies on that when it removes a row.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/reminder_minutes_layout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:hint="@string/accessibility_reminder_time"
        app:layout_constraintEnd_toStartOf="@+id/reminder_remove"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.android.calendar.event.ExposedDropdownField
            android:id="@+id/reminder_minutes_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:singleLine="false" />
    </com.google.android.material.textfield.TextInputLayout>

    <CheckBox
        android:id="@+id/reminder_minutes_sign"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:minHeight="48dp"
        android:gravity="center_vertical|start"
        android:text="@string/after_start_of_event"
        app:layout_constraintEnd_toStartOf="@+id/reminder_remove"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/reminder_minutes_layout" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/reminder_method_layout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:hint="@string/accessibility_reminder_type"
        app:layout_constraintEnd_toStartOf="@+id/reminder_remove"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/reminder_minutes_sign">

        <com.android.calendar.event.ExposedDropdownField
            android:id="@+id/reminder_method_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:singleLine="false" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 48dp touch target, vertically centred on the time field. -->
    <ImageButton
        android:id="@+id/reminder_remove"
        style="@style/MinusButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/accessibility_remove_reminder"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/reminder_minutes_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/reminder_minutes_layout" />

</androidx.constraintlayout.widget.ConstraintLayout>
