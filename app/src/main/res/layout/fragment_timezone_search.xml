<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-screen time zone search page. One search row at the top (back, borderless input, clear);
  no outlined field, no floating label, no second title bar. System bars stay visible.
  The row and the list share one width, capped at 600dp on wide screens.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/timezone_search_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:accessibilityPaneTitle="@string/timezone_search_title"
    android:background="?attr/colorSurface"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/timezone_search_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="600dp">

        <ImageButton
            android:id="@+id/timezone_search_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/timezone_search_back"
            android:src="@drawable/ic_arrow_back"
            android:tint="?attr/colorControlNormal" />

        <EditText
            android:id="@+id/timezone_search_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/timezone_search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingTop="12dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp"
            android:singleLine="true"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:textSize="16sp" />

        <!-- Clears the query only. Kept invisible (not gone) when empty, so the field does not jump. -->
        <ImageButton
            android:id="@+id/timezone_search_clear"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/timezone_search_clear"
            android:src="@drawable/ic_close"
            android:tint="?attr/colorControlNormal"
            android:visibility="invisible" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/timezone_search_results"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/timezone_search_bar"
        app:layout_constraintWidth_max="600dp" />
</androidx.constraintlayout.widget.ConstraintLayout>
