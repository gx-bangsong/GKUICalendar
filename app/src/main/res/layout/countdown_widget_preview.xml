<?xml version="1.0" encoding="utf-8"?>
<!-- Static preview for the Android 12+ widget picker. previewLayout is
     inflated without a RemoteViewsService, so the real list would be empty.
     Keep in sync with countdown_widget.xml / countdown_widget_item.xml. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_container_bg"
    android:orientation="vertical"
    android:paddingStart="@dimen/widget_padding"
    android:paddingEnd="@dimen/widget_padding"
    android:paddingTop="@dimen/widget_padding"
    android:paddingBottom="4dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/countdown_widget_label"
        android:textColor="@color/widget_on_surface"
        android:textSize="@dimen/widget_title_text" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_chip_md3_filled"
        android:backgroundTint="@color/widget_preview_chip_2"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/countdown_preview_event_1"
                android:textColor="#FFFFFFFF"
                android:textSize="@dimen/widget_item_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/countdown_preview_date_1"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/countdown_preview_days_1"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/widget_row_spacing"
        android:background="@drawable/widget_chip_md3_filled"
        android:backgroundTint="@color/widget_preview_chip_3"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/countdown_preview_event_2"
                android:textColor="#FF1A1C1E"
                android:textSize="@dimen/widget_item_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/countdown_preview_date_2"
                android:textColor="#CC1A1C1E"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/countdown_preview_days_2"
            android:textColor="#FF1A1C1E"
            android:textSize="20sp" />
    </LinearLayout>
</LinearLayout>
