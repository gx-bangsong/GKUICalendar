<!--
  Headline of the event detail page (Material 3). One small rounded colour marker sits in the
  icon column, so the title starts on the same x as the information rows. The marker takes the
  resolved event colour (falling back to the calendar colour) in EventInfoFragment. The action
  buttons are kept here for the dialog / pane host and stay GONE on the full-screen page, which
  has its own action bar (event_info_action_bar).
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/event_info_headline"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="top"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- The single colour mark, in the same 24dp column as the row icons -->
    <FrameLayout
        android:layout_width="24dp"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/event_info_color_marker"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- WHAT: wraps onto several lines for long titles -->
    <TextView
        android:id="@+id/title"
        style="?attr/textAppearanceHeadlineSmall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:autoLink="all"
        android:textColor="?attr/colorOnSurface"
        android:textColorLink="?attr/colorPrimary"
        android:textIsSelectable="true" />

    <!-- ACTIONS: the same buttons as before, shown only when the event permits them -->
    <LinearLayout
        android:id="@+id/event_info_buttons_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="4dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/change_color"
            style="?attr/materialIconButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/choose_event_color_label"
            android:enabled="false"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/outline_color_lens"
            android:visibility="gone"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/edit"
            style="?attr/materialIconButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/edit_label"
            android:enabled="false"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/outline_edit_event"
            android:visibility="gone"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/delete"
            style="?attr/materialIconButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/delete_label"
            android:enabled="false"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/outline_delete_event"
            android:visibility="gone"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</LinearLayout>
