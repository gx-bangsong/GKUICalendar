<!--
  Headline of the event detail page (Material 3). One colour marker and the large title sit on
  the surface, so the event colour never tints the whole block. The action set is edit, delete
  and colour, and each button is shown only when the event allows it (see EventInfoFragment).
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/event_info_headline"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="top"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- The single colour mark of the event (or its calendar when no event colour is set) -->
    <View
        android:id="@+id/event_info_color_marker"
        android:layout_width="4dp"
        android:layout_height="32dp"
        android:layout_marginTop="4dp"
        android:background="?attr/colorPrimary"
        android:importantForAccessibility="no" />

    <!-- WHAT: wraps onto several lines for long titles -->
    <TextView
        android:id="@+id/title"
        style="?attr/textAppearanceHeadlineSmall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:autoLink="all"
        android:textColor="?attr/colorOnSurface"
        android:textColorLink="?attr/colorPrimary"
        android:textIsSelectable="true" />

    <!-- ACTIONS: the same buttons as before, shown only when the event permits them -->
    <LinearLayout
        android:id="@+id/event_info_buttons_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="4dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/change_color"
            style="?attr/materialIconButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/choose_event_color_label"
            android:enabled="false"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/outline_color_lens"
            android:visibility="gone"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/edit"
            style="?attr/materialIconButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/edit_label"
            android:enabled="false"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/outline_edit_event"
            android:visibility="gone"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/delete"
            style="?attr/materialIconButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/delete_label"
            android:enabled="false"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/outline_delete_event"
            android:visibility="gone"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</LinearLayout>
