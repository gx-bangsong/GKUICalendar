<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/edit_event_all"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="24dp"
            android:background="@null"
            android:focusable="true"
            android:hint="@string/hint_what"
            android:inputType="textAutoCorrect|textCapSentences"
            android:minHeight="48dip"
            android:singleLine="true"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <HorizontalScrollView
            android:id="@+id/event_types_scroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/title"
            app:layout_constraintTop_toBottomOf="@+id/title">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/event_types"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true">
                <!-- Chips are likely added programmatically or were here before -->
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <View
            android:id="@+id/separator_title"
            style="@style/EditEventSeparator"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/event_types_scroll" />

        <!-- Calendar Selector -->
        <ImageView
            android:id="@+id/calendar_selector_group_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="24dp"
            android:src="@drawable/outline_account_circle"
            app:layout_constraintBottom_toBottomOf="@+id/calendars_spinner"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/calendars_spinner" />

        <View
            android:id="@+id/calendar_selector_group_background"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="2dp"
            app:layout_constraintStart_toStartOf="@+id/calendar_selector_group_icon"
            app:layout_constraintTop_toTopOf="@+id/calendar_selector_group_icon" />

        <Spinner
            android:id="@+id/calendars_spinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="8dp"
            android:gravity="center_vertical"
            android:popupBackground="?attr/colorSurfaceContainer"
            app:layout_constraintEnd_toStartOf="@+id/change_color"
            app:layout_constraintStart_toEndOf="@+id/calendar_selector_group_icon"
            app:layout_constraintTop_toBottomOf="@+id/separator_title" />

        <ImageButton
            android:id="@+id/change_color"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="16dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/choose_event_color_label"
            android:src="@drawable/outline_color_lens"
            app:layout_constraintBottom_toBottomOf="@+id/calendars_spinner"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/calendars_spinner" />

        <View
            android:id="@+id/separator_calendar"
            style="@style/EditEventSeparator"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/calendars_spinner" />

        <!-- ALL DAY -->
        <ImageView
            android:id="@+id/imageView"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="24dp"
            android:src="@drawable/ic_outline_schedule"
            app:layout_constraintBottom_toBottomOf="@+id/is_all_day"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/is_all_day" />

        <TextView
            android:id="@+id/is_all_day_label"
            style="@style/TextAppearance.EditEvent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/edit_event_all_day_label"
            app:layout_constraintBottom_toBottomOf="@+id/is_all_day"
            app:layout_constraintStart_toEndOf="@+id/imageView"
            app:layout_constraintTop_toTopOf="@+id/is_all_day" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/is_all_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/separator_calendar" />

        <!-- FROM / TO Rows -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/start_row_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingVertical="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/is_all_day_label"
            app:layout_constraintTop_toBottomOf="@+id/is_all_day">

            <Button
                android:id="@+id/start_date"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="0dp"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Thu, Sep 5, 2024" />

            <Button
                android:id="@+id/start_time"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="2:00 PM" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/end_row_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/is_all_day_label"
            app:layout_constraintTop_toBottomOf="@+id/start_row_container">

            <Button
                android:id="@+id/end_date"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="0dp"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Thu, Sep 5, 2024" />

            <Button
                android:id="@+id/end_time"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="3:00 PM" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.Group
            android:id="@+id/timezone_button_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="timezone_icon,timezone_button" />

        <!-- TIME ZONE -->
        <ImageView
            android:id="@+id/timezone_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="24dp"
            android:src="@drawable/ic_outline_public"
            app:layout_constraintBottom_toBottomOf="@+id/timezone_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/timezone_button" />

        <Button
            android:id="@+id/timezone_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="24dp"
            android:gravity="start|center_vertical"
            android:paddingStart="0dp"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/timezone_icon"
            app:layout_constraintTop_toBottomOf="@+id/end_row_container" />

        <!-- REPEATS -->
        <ImageView
            android:id="@+id/rrule_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="24dp"
            android:src="@drawable/ic_outline_repeat"
            app:layout_constraintBottom_toBottomOf="@+id/rrule"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/rrule" />

        <Button
            android:id="@+id/rrule"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="24dp"
            android:gravity="start|center_vertical"
            android:paddingStart="0dp"
            android:text="@string/does_not_repeat"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/rrule_icon"
            app:layout_constraintTop_toBottomOf="@+id/timezone_button" />

        <View
            android:id="@+id/separator_datetime"
            style="@style/EditEventSeparator"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rrule" />

        <!-- ATTENDEES -->
        <androidx.constraintlayout.widget.Group
            android:id="@+id/add_attendees_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="attendees_icon,add_attendees_row" />

        <ImageView
            android:id="@+id/attendees_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="24dp"
            android:src="@drawable/ic_outline_person_add"
            app:layout_constraintBottom_toBottomOf="@+id/add_attendees_row"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/add_attendees_row" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/add_attendees_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/attendees_icon"
            app:layout_constraintTop_toBottomOf="@+id/separator_datetime">

            <com.android.calendar.chips.RecipientEditTextView
                android:id="@+id/attendees"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/hint_attendees"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress|textMultiLine|textCapWords"
                android:minHeight="48dp"
                android:padding="0dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <View
            android:id="@+id/separator_attendees"
            style="@style/EditEventSeparator"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/add_attendees_row" />

        <!-- WHERE -->
        <ImageView
            android:id="@+id/where_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="24dp"
            android:src="@drawable/ic_outline_place"
            app:layout_constraintBottom_toBottomOf="@+id/where_row"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/where_row" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/where_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/where_icon"
            app:layout_constraintTop_toBottomOf="@+id/separator_attendees">

            <AutoCompleteTextView
                android:id="@+id/location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/hint_where"
                android:imeOptions="actionDone"
                android:inputType="textAutoCorrect|textCapSentences"
                android:minHeight="48dip"
                android:padding="0dp"
                android:singleLine="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- DESCRIPTION -->
        <ImageView
            android:id="@+id/description_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="24dp"
            android:src="@drawable/ic_outline_notes"
            app:layout_constraintBottom_toBottomOf="@+id/description_row"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/description_row" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/description_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/description_icon"
            app:layout_constraintTop_toBottomOf="@+id/where_row">

            <EditText
                android:id="@+id/description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/hint_description"
                android:imeOptions="actionDone"
                android:inputType="textAutoCorrect|textCapSentences|textMultiLine"
                android:minHeight="48dip"
                android:padding="0dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- URL -->
        <ImageView
            android:id="@+id/url_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="24dp"
            android:src="@drawable/ic_outline_link"
            app:layout_constraintBottom_toBottomOf="@+id/url_row"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/url_row" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/url_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/url_icon"
            app:layout_constraintTop_toBottomOf="@+id/description_row">

            <EditText
                android:id="@+id/url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/hint_url"
                android:imeOptions="actionDone"
                android:inputType="textUri"
                android:minHeight="48dip"
                android:padding="0dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <View
            android:id="@+id/separator_details"
            style="@style/EditEventSeparator"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/url_row" />

        <!-- REMINDERS -->
        <ImageView
            android:id="@+id/reminder_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="24dp"
            android:src="@drawable/ic_outline_notifications"
            app:layout_constraintBottom_toBottomOf="@+id/reminder_add"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/reminder_add" />

        <LinearLayout
            android:id="@+id/reminder_items_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="24dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/reminder_icon"
            app:layout_constraintTop_toBottomOf="@+id/separator_details" />

        <Button
            android:id="@+id/reminder_add"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="24dp"
            android:gravity="start|center_vertical"
            android:paddingStart="0dp"
            android:text="@string/reminders_label"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/reminder_icon"
            app:layout_constraintTop_toBottomOf="@+id/reminder_items_container" />

        <View
            android:id="@+id/separator_reminders"
            style="@style/EditEventSeparator"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/reminder_add" />

        <!-- AVAILABILITY -->
        <ImageView
            android:id="@+id/availability_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="24dp"
            android:src="@drawable/ic_outline_business_center"
            app:layout_constraintBottom_toBottomOf="@+id/availability"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/availability" />

        <Spinner
            android:id="@+id/availability"
            style="@style/TextAppearance.EditEvent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="24dp"
            android:popupBackground="?attr/colorSurfaceContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/availability_icon"
            app:layout_constraintTop_toBottomOf="@+id/separator_reminders" />

        <!-- VISIBILITY -->
        <ImageView
            android:id="@+id/visibility_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="24dp"
            android:src="@drawable/ic_outline_lock"
            app:layout_constraintBottom_toBottomOf="@+id/visibility"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/visibility" />

        <Spinner
            android:id="@+id/visibility"
            style="@style/TextAppearance.EditEvent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="24dp"
            android:popupBackground="?attr/colorSurfaceContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/visibility_icon"
            app:layout_constraintTop_toBottomOf="@+id/availability" />

        <!-- RESPONSE GROUP -->
        <androidx.constraintlayout.widget.Group
            android:id="@+id/response_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="response_label,response_value" />

        <TextView
            android:id="@+id/response_label"
            style="@style/TextAppearance.EditEvent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="64dp"
            android:layout_marginTop="16dp"
            android:text="@string/view_event_response_label"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/visibility" />

        <RadioGroup
            android:id="@+id/response_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="64dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="24dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/response_label">

            <RadioButton
                android:id="@+id/response_yes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/response_yes" />

            <RadioButton
                android:id="@+id/response_maybe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/response_maybe" />

            <RadioButton
                android:id="@+id/response_no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/response_no" />
        </RadioGroup>

        <!-- ORGANIZER -->
        <LinearLayout
            android:id="@+id/organizer_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="64dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="24dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/response_value">

            <TextView
                android:id="@+id/organizer_label"
                style="@style/TextAppearance.EditEvent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/view_event_organizer_label" />

            <TextView
                android:id="@+id/organizer"
                style="@style/TextAppearance.EditEvent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Home Time Zone Rows (Hidden by default) -->
    <LinearLayout
        android:id="@+id/from_row_home_tz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="64dp"
        android:visibility="gone">
        <TextView android:id="@+id/start_date_home_tz" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_weight="1" />
        <TextView android:id="@+id/start_time_home_tz" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/to_row_home_tz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="64dp"
        android:visibility="gone">
        <TextView android:id="@+id/end_date_home_tz" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_weight="1" />
        <TextView android:id="@+id/end_time_home_tz" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Read-only views (Mostly for reference/compat) -->
    <LinearLayout android:id="@+id/when_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <TextView android:id="@+id/when_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/when_label" />
        <TextView android:id="@+id/when" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout android:id="@+id/timezone_textview_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone">
        <TextView android:id="@+id/timezone_textView" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

</LinearLayout>
