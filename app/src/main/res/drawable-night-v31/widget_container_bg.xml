<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ dark: neutral_900 is the dynamic dark surface tone. Without
     this the -v31 light variant (accent1_50) wins at night and the widget
     renders as a light card on a dark home screen. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/widget_corner_radius" />
    <solid android:color="@android:color/system_neutral1_900" />
</shape>
